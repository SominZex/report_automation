# .streamlit/secrets.toml
#
# Copy this file to .streamlit/secrets.toml (same folder structure, next to
# brand_date_portal.py) and fill in real values. Never commit the real file —
# add ".streamlit/secrets.toml" to .gitignore.
#
# purchase_report_portal.py reads every value below via _config(), which
# checks st.secrets first and falls back to the environment / .env — so the
# same script works unchanged from the Streamlit portal AND from cron/Airflow
# (which should instead set these as real environment variables or a .env
# file, since there's no Streamlit runtime there).

# ── Database ──────────────────────────────────────────────────────────────
DB_USER     = "your_db_user"
DB_PASSWORD = "your_db_password"
DB_HOST     = "your_db_host"
DB_PORT     = "5432"
DB_NAME     = "sales_data"

# ── Stock API (thenewshop.in) ────────────────────────────────────────────
STOCK_API_LOGIN_URL = "https://api.thenewshop.in/login"
STOCK_API_STOCK_URL = "https://api.thenewshop.in/store-stocks/report/storeStocksCSV"
STOCK_API_USERNAME  = "your_stock_api_username"
STOCK_API_PASSWORD  = "your_stock_api_password"

# ── Report delivery email (Zoho Mail SMTP) ───────────────────────────────
REPORT_MAIL_SMTP_SERVER = "smtp.zoho.in"
REPORT_MAIL_SMTP_PORT   = "465"
REPORT_MAIL_SENDER      = "your_sender@newshop.in"
REPORT_MAIL_PASSWORD    = "your_mailbox_app_password"
REPORT_MAIL_RECIPIENT   = "sharmishtha.gupta@newshop.in"
REPORT_MAIL_CC          = ""
REPORT_MAIL_BCC         = ""
REPORT_ATTACH_SIZE_LIMIT_MB = "20"

# ── Zoho WorkDrive (only used when the report exceeds the attach limit) ──
ZOHO_ACCOUNTS_BASE           = "https://accounts.zoho.in"
ZOHO_API_BASE                = "https://www.zohoapis.in"
ZOHO_WORKDRIVE_CLIENT_ID     = ""
ZOHO_WORKDRIVE_CLIENT_SECRET = ""
ZOHO_WORKDRIVE_REFRESH_TOKEN = ""
ZOHO_WORKDRIVE_FOLDER_ID     = ""

# ── Report content ────────────────────────────────────────────────────────
MONDELEZ_BRAND_GROUP = "Mondelez"
